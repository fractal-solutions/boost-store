# Boost Store configuration. Copy to `.env` and adjust.

PORT=4000
# Bind address. 0.0.0.0 exposes the store to your local network (phone testing).
HOST=0.0.0.0
# Public base URL used to build payment callback URLs.
APP_BASE_URL=http://localhost:4000

# --- Delivery (boost-carrier / Uber Direct) ---
# `boost-carrier` calls the boost-carrier service (which talks to Uber Direct).
# `simulated` runs a local fake courier with no external services.
DELIVERY_PROVIDER=boost-carrier
BOOST_CARRIER_URL=http://localhost:5000
BOOST_CARRIER_CUSTOMER_ID=PENDING_MERCHANT_ID_PLACEHOLDER
# Shared secret used to verify webhooks forwarded by boost-carrier.
# Set this to the same value as boost-carrier's UBER_WEBHOOK_SIGNING_KEY.
DELIVERY_WEBHOOK_SECRET=

# --- Payments ---
# Mock gateway is always available. M-PESA (Daraja) is opt-in.
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Optional override; defaults to APP_BASE_URL + /api/payments/mpesa/callback
MPESA_CALLBACK_URL=

# Default checkout payment timing: `prepay` or `cod` (pay on delivery).
PAYMENT_TIMING_DEFAULT=prepay

# --- Demo data ---
DEMO_MERCHANT_EMAIL=demo@booststore.app
DEMO_MERCHANT_PASSWORD=booststore

# --- Maps, geocoding & routing ---
# Address search + reverse geocoding (Photon-compatible; key-less by default).
GEOCODER_URL=https://photon.komoot.io/api/
GEOCODER_USER_AGENT=boost-store/1.0
# Restrict address search to a country / area (defaults to Kenya).
GEOCODER_COUNTRY=KE
GEOCODER_BBOX=33.89,-4.68,41.86,5.03
# Turn-by-turn routing between pickup and drop-off (OSRM-compatible).
ROUTER_URL=https://router.project-osrm.org
ROUTER_PROFILE=driving
# Map tiles served to the browser via /api/map-config.
MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_MAX_ZOOM=20
# Default map view (Nairobi).
MAP_DEFAULT_LAT=-1.2864
MAP_DEFAULT_LNG=36.8172
MAP_DEFAULT_ZOOM=12
# CARTO Basemaps API key — removes the "API key required" watermark.
CARTO_API_KEY=

# Demo pickup / drop-off coordinates used by the delivery map.
# The bundled mock reports a fixed courier location in San Francisco
# (37.7749, -122.4194); the dev-stack aligns these to it for a coherent map.
DEMO_PICKUP_LAT=-1.2864
DEMO_PICKUP_LNG=36.8172
DEMO_DROPOFF_LAT=-1.2921
DEMO_DROPOFF_LNG=36.8219
